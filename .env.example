# Скопируйте этот файл в .env и заполните значениями.
# .env в .gitignore и не должен попадать в репозиторий.

# --- Supabase (обязательно) ---------------------------------------------
# Settings -> API в панели вашего проекта Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — даёт полный доступ в обход RLS, используется только
# на сервере (createAdminClient()). Никогда не публикуйте и не используйте
# на клиенте.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (обязательно для загрузки фото товаров) ------------------
# Без этих переменных сама загрузка/удаление фото вернёт ошибку, но
# остальной сайт (включая просмотр карточек товаров) работает нормально.
# cloudinary.com -> Dashboard -> Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Telegram-уведомления (опционально) -----------------------------------
# Без этих переменных уведомления в Telegram просто не отправляются —
# остальной функционал не затронут.
# Токен бота — из @BotFather. TELEGRAM_CHAT_ID — id группового чата,
# куда шлются общие уведомления (id узнать через @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет вебхука (опционально, но желательно) — защищает
# /api/telegram/webhook от чужих POST-запросов не от Telegram. Придумайте
# любую длинную случайную строку, впишите сюда же и один раз зарегистрируйте
# её у Telegram (замените <TOKEN> и <SECRET> и выполните из терминала):
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://ваш-домен/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=
